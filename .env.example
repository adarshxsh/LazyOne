# Copy to .env for local development.
DEBUG=True
DJANGO_SECRET_KEY=change-me-local-only

# Local Postgres (Homebrew: brew services start postgresql@18 && createdb lazyone)
DATABASE_URL=postgres://YOUR_MAC_USERNAME@localhost:5432/lazyone

# Keep local data out of your real Firestore project (chat then polls Django).
REALTIME_ENABLED=False

# Optional: Firebase (realtime chat + phone verification). Without it chat falls back to polling.
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Optional: Google login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------- Production (set these in Vercel > Settings > Environment Variables) ----------------
# DEBUG=False
# DJANGO_SECRET_KEY=<new random 50+ chars; never the old committed one>
# DATABASE_URL=postgres://...pooler...:6543/postgres?sslmode=require   (Neon/Supabase pooled URL)
# DB_CONN_MAX_AGE=0                      # serverless: let the pooler keep connections
# ALLOWED_HOSTS=your-app.vercel.app,yourdomain.com
# CSRF_TRUSTED_ORIGINS=https://your-app.vercel.app,https://yourdomain.com
# CRON_SECRET=<long random string>       # Vercel Cron + external cron send it as a Bearer token
# REDIS_URL=rediss://default:...@....upstash.io:6379   # shared cache: rate limits, wave circles
# ADMIN_URL=manage-<random>/             # admin is not at /admin/
# SECURE_HSTS_SECONDS=31536000           # once HTTPS works on your final domain
# FIREBASE_SERVICE_ACCOUNT_JSON=<service account JSON, raw or base64>   # instead of the key file
# REALTIME_ENABLED=True
# Sign-in: Google is the main way in. Email + password sign-up turns on automatically once
# EMAIL_HOST is set (or force with EMAIL_SIGNUP_ENABLED=True/False).
# EMAIL_HOST=smtp-relay.brevo.com  EMAIL_HOST_USER=...  EMAIL_HOST_PASSWORD=...  DEFAULT_FROM_EMAIL=LazyOne <no-reply@yourdomain.com>
# SIGNUP_BONUS_REQUIRES_VERIFICATION=True   UNVERIFIED_STARTER_POINTS=100
